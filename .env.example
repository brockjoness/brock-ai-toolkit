# brock-ai-toolkit — aggregated env vars
#
# This is the union of every env var any tool, skill, or app in this repo expects.
# You only need the ones for the skills/apps you actually run.
# Each skill / app folder also has its own .env.example listing just what it needs.
#
# Copy this file to `.env` (or `.env.local` for the Next.js apps) and fill in.
# Never commit `.env`.

# ─────────────────────────────────────────────────────────────────────────
# LLMs
# ─────────────────────────────────────────────────────────────────────────

# Anthropic — most skills use Claude for analysis, generation, classification.
ANTHROPIC_API_KEY=

# Google Generative AI — image generation (Nano Banana / Gemini), multimodal.
# Some skills use GOOGLE_API_KEY, others GEMINI_API_KEY — they're the same key.
GOOGLE_API_KEY=
GEMINI_API_KEY=
NANO_BANANA_API_KEY=

# Google Veo 3 — video generation (optional, only for creative-production-router).
GOOGLE_VEO_API_KEY=

# Perplexity — competitor research, market snapshots, prospect audits.
PERPLEXITY_API_KEY=

# Fal.ai — hosted image/video model inference (e.g. Kling video).
FAL_KEY=

# HeyGen — AI UGC video (optional, only for creative-production-router).
HEYGEN_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Data sources / lead generation
# ─────────────────────────────────────────────────────────────────────────

# Apify — Google Maps scraping, LinkedIn scraping, web scraping.
APIFY_API_TOKEN=

# AnyMailFinder — email enrichment for scraped leads.
ANYMAILFINDER_API_KEY=

# Meta Marketing API — Ads Library, ad account access.
META_ACCESS_TOKEN=

# ─────────────────────────────────────────────────────────────────────────
# Outbound / CRM
# ─────────────────────────────────────────────────────────────────────────

# Instantly — cold email campaigns + autoreplies.
INSTANTLY_API_KEY=

# Stripe — invoicing during client onboarding.
STRIPE_API_KEY=

# Slack — incoming webhook for pings (optional, leave empty to disable).
SLACK_WEBHOOK_URL=

# ─────────────────────────────────────────────────────────────────────────
# Notion (used as the operational source of truth across many skills)
# ─────────────────────────────────────────────────────────────────────────

# Notion integration token (single token, scoped per workspace).
NOTION_API_KEY=

# Database IDs — fill in the IDs from your own Notion workspace.
YOUR_NOTION_CRM_DB_ID=
YOUR_NOTION_WORKFLOW_DB_ID=

# ─────────────────────────────────────────────────────────────────────────
# Google Workspace (Docs, Drive, Sheets via service account)
# ─────────────────────────────────────────────────────────────────────────

# Absolute path to a service account JSON file with Docs/Drive/Sheets scopes.
# Used by client-onboarding (contract gen), scrape-leads, gmaps-leads.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Google Doc template + Drive folder for contract generation.
YOUR_GOOGLE_DOC_TEMPLATE_ID=
YOUR_GOOGLE_DRIVE_FOLDER_ID=

# ─────────────────────────────────────────────────────────────────────────
# Supabase (only for the dashboard app)
# ─────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Misc
# ─────────────────────────────────────────────────────────────────────────

# Calendar booking link slug used in welcome emails (e.g. "brock/intro").
YOUR_CALENDAR_SLUG=

# Public app URL (used by the dashboard app for links/redirects).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Remotion edit pipeline — local cache directory.
REMOTION_PUBLIC_CACHE_DIR=
