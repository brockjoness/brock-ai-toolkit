# Sales skills — shared env vars. Each skill folder may have its own .env.example
# for vars it specifically needs.

# Anthropic — used by classification, casualization, cold email generation
ANTHROPIC_API_KEY=

# Apify — used by scrape-leads, gmaps-leads
APIFY_API_TOKEN=

# Instantly — used by cold-email-campaigns, cold-email-autoreply
INSTANTLY_API_KEY=

# Perplexity — used by prospect-audit market snapshot
PERPLEXITY_API_KEY=

# AnyMailFinder — used by scrape-leads email enrichment
ANYMAILFINDER_API_KEY=

# Google service account JSON path — for Sheets/Calendar via google-api-python-client
GOOGLE_APPLICATION_CREDENTIALS=

# Notion integration token — used by lead-enrichment, prospect-audit, call-prep
NOTION_API_KEY=
