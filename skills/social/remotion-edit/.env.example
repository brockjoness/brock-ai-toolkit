# Absolute path to your Remotion project's public/cache directory.
# link_cache.sh will symlink ~/.cache/remotion-edit/<hash> into here so
# Remotion's staticFile() can resolve the alpha matte without iCloud syncing it.
# TODO: set REMOTION_PUBLIC_CACHE_DIR in .env
REMOTION_PUBLIC_CACHE_DIR=

# Optional: override the whisper.cpp model path
# Default: $HOME/.cache/whisper-cpp/ggml-base.en.bin
# WHISPER_MODEL=
